{ Places the pen-and-ink version of the painting on the Bottom Overlay of the open PCB.
  1128 strokes, 1761 track segments, 0.16 mm wide, inside a 46 x 46 mm square
  2 mm in from the lower-left corner of the board outline. Coordinates are in microns.
  Mirrored so it reads correctly when the board is viewed from the bottom.
  First offers to delete existing free fills and tracks on Bottom Overlay (earlier versions of the art).
  Run with the PcbDoc active: File > Run Script > PlacePaintingArtwork.PrjScr > PlacePaintingArtwork. }

Var
  Board : IPCB_Board;
  BX, BY : TCoord;
  Count : Integer;

Procedure T(X1, Y1, X2, Y2 : Integer);
Var
  Tr : IPCB_Track;
Begin
  Tr := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
  Tr.X1 := BX + MMsToCoord(X1 / 1000);
  Tr.Y1 := BY + MMsToCoord(Y1 / 1000);
  Tr.X2 := BX + MMsToCoord(X2 / 1000);
  Tr.Y2 := BY + MMsToCoord(Y2 / 1000);
  Tr.Width := MMsToCoord(0.16);
  Tr.Layer := eBottomOverlay;
  Board.AddPCBObject(Tr);
  PCBServer.SendMessageToRobots(Board.I_ObjectAddress, c_Broadcast, PCBM_BoardRegisteration, Tr.I_ObjectAddress);
  Count := Count + 1;
End;

Procedure RemoveOldArt;
Var
  Iter : IPCB_BoardIterator;
  Obj  : IPCB_Primitive;
  List : TInterfaceList;
  I    : Integer;
Begin
  List := TInterfaceList.Create;
  Iter := Board.BoardIterator_Create;
  Iter.AddFilter_ObjectSet(MkSet(eFillObject, eTrackObject));
  Iter.AddFilter_LayerSet(MkSet(eBottomOverlay));
  Iter.AddFilter_Method(eProcessAll);
  Obj := Iter.FirstPCBObject;
  While Obj <> Nil Do
  Begin
    If Not Obj.InComponent Then List.Add(Obj);
    Obj := Iter.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(Iter);
  If List.Count > 0 Then
    If ConfirmNoYes('Delete the ' + IntToStr(List.Count) + ' existing fills and tracks on Bottom Overlay (the earlier artwork) first?') Then
      For I := 0 To List.Count - 1 Do
        Board.RemovePCBObject(List.Items[I]);
  List.Free;
End;

